# OpenAI API Configuration
OPENAI_API_KEY="your-openai-api-key-here"
ACTIVE_MODEL="tts-1"
AI_VOICE="alloy"
TTS_SPEED="1.0"

# Application Settings
MIN_TEXT_LENGTH=50
CHUNK_SIZE=3000
ENABLE_CACHE=true

# Prevent Python from writing bytecode (.pyc / __pycache__)
PYTHONDONTWRITEBYTECODE=1

# Directory Paths
CACHE_DIR="cache"
AUDIO_DIR="audio"
LOG_DIR="logs"
